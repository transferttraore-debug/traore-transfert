rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    function isActive() { return signedIn() && profile().active == true; }
    function isAdmin() { return isActive() && profile().role == "admin"; }

    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Profile role is provisioned by an administrator from a trusted environment.
      allow create, update, delete: if false;
    }
    match /backups/{uid} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
